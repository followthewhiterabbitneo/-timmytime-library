        <mxCell id="orecx2" value="OrecX Oreka Recorder 2&#10;RHEL 9 — 10.10.21.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EE0000;strokeColor=#A30000;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="470" y="540" width="200" height="80" as="geometry" />
        </mxCell>

