        <!-- OrecX recorders container -->
        <mxCell id="recgrp" value="Call Recording — OrecX (RHEL 9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#EE0000;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1">
