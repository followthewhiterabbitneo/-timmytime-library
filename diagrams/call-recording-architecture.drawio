          <mxGeometry x="350" y="350" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e3" value="SIPREC — SIP/TLS tcp/5061&#10;SRS metadata + forked RTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontStyle=1;" edge="1" parent="1" source="cucm" target="f5">
