        <mxCell id="title" value="Call Recording Architecture — OrecX component detail" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="760" height="30" as="geometry" />
